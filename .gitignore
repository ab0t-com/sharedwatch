# sharedwatch top-level .gitignore
# (per-language details live alongside the Go module in src/)

# --- Build & release artifacts ---
# dist/ is the staging directory for scripts/release.sh — ephemeral.
# release/ is committed to the repo and served via raw.githubusercontent.com
# (see scripts/install.sh). Each release lives under release/vX.Y.Z/.
dist/
src/.bin/
src/.ci-bin/
.ci-bin/
*.tar.gz
!release/**/*.tar.gz
*.tar.zst
*.zip

# --- Go ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
*.coverprofile
profile.cov
go.work
go.work.sum
# vendor/   # uncomment if vendoring

# --- SQLite (sharedwatch local state — never check in) ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal

# --- sharedwatch local data dirs (when developers run the daemon in-repo) ---
src/watch/
src/sharedwatch.lock
src/queue.db*
src/.bin/
src/.env.build.local

# --- Secrets & env ---
.env
.env.*
!.env.example
.envrc

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.zed/
*.sublime-workspace
*.sublime-project

# --- Gitleaks bins shipped by CI step (do not commit) ---
gitleaks
gitleaks_*.tar.gz

# --- Local-only notes (not for public release; keep your own) ---
notes-local-*.md
TODO-local-*.md
